{
  "name": "nocturne-browser",
  "version": "0.10.22",
  "private": true,
  "description": "A glass and graphite Chromium browser",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node tests/smoke.cjs",
    "test:features": "node tests/features.cjs",
    "test:layout": "node tests/layout-smoke.cjs",
    "test:suggestions": "node tests/suggestions-smoke.cjs",
    "test:setup": "node tests/onboarding-smoke.cjs",
    "test:bilingual": "node tests/bilingual-smoke.cjs",
    "package": "node scripts/package.mjs",
    "test:security": "node tests/security-smoke.cjs",
    "test:controls": "node tests/controls-smoke.cjs",
    "test:overlays": "node tests/overlay-smoke.cjs",
    "test:drag-regions": "node tests/drag-region-smoke.cjs",
    "test:last-tab": "node tests/last-tab-smoke.cjs",
    "test:recovery": "node tests/recovery-smoke.cjs",
    "test:profiles": "node tests/profiles-smoke.cjs",
    "test:auto-import": "node tests/automatic-import-smoke.cjs",
    "installer": "node scripts/build-installer.mjs",
    "release": "node scripts/release.mjs",
    "test:installer": "node scripts/verify-installer.mjs",
    "test:ai": "node tests/ai-assistant-smoke.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.1",
    "tldts": "^7.4.19"
  }
}
